   private void realizarInscricao() {
      Evento evento = (Evento)this.comboEventos.getSelectedItem();
      Participante participante = (Participante)this.comboParticipantes.getSelectedItem();
      if (evento != null && participante != null) {
         String mensagem = this.inscricaoController.realizarIncricao(evento.getCodigo(), participante.getCodigo());
         JOptionPane.showMessageDialog(this, mensagem);
         this.atualizarTabela();
      } else {
         JOptionPane.showMessageDialog(this, "Cadastre um evento e um participante primeiro!");
      }
   }

   private void cancelarInscricao() {
      int linha = this.tabela.getSelectedRow();
      if (linha == -1) {
         JOptionPane.showMessageDialog(this, "Selecione uma inscrição na tabela!");
      } else {
         int codigoEvento = (Integer)this.modelo.getValueAt(linha, 0);
         int codigoParticipante = (Integer)this.modelo.getValueAt(linha, 2);
         int resposta = JOptionPane.showConfirmDialog(this, "Deseja realmente cancelar esta inscrição?", "Confirmar cancelamento", 0);
         if (resposta == 0) {
            String mensagem = this.inscricaoController.cancelarInscricao(codigoEvento, codigoParticipante);
            JOptionPane.showMessageDialog(this, mensagem);
            this.atualizarTabela();
         }

      }
   }

   private void atualizarCombos() {
      this.comboEventos.removeAllItems();
      this.comboParticipantes.removeAllItems();

      for(Evento evento : this.eventoController.listarEventos()) {
         this.comboEventos.addItem(evento);
      }

      for(Participante participante : this.participanteController.listarParticipantes()) {
         this.comboParticipantes.addItem(participante);
      }

   }

   public void atualizarTabela() {
      this.modelo.setRowCount(0);

      for(Inscricao inscricao : this.inscricaoController.listarTodasInscricoes()) {
         this.modelo.addRow(new Object[]{inscricao.getEvento().getCodigo(), inscricao.getEvento().getNome(), inscricao.getParticipante().getCodigo(), inscricao.getParticipante().getNome()});
      }

      this.atualizarCombos();
   }
