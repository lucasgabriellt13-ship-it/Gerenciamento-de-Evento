   private void atualizarEventos() {
      this.comboEventos.removeAllItems();

      for(Evento evento : this.eventoController.listarEventos()) {
         this.comboEventos.addItem(evento);
      }

   }

   private void gerarRelatorio() {
      Evento evento = (Evento)this.comboEventos.getSelectedItem();
      if (evento == null) {
         JOptionPane.showMessageDialog(this, "Nenhum evento cadastrado!");
      } else {
         int quantidade = this.inscricaoController.contarInscritos(evento.getCodigo());
         int vagas = this.inscricaoController.calcularVagasDisponiveis(evento.getCodigo());
         this.lblInscritos.setText("Inscritos: " + quantidade);
         this.lblVagas.setText("Vagas disponíveis: " + vagas);
         this.lblCapacidade.setText("Capacidade máxima: " + evento.getCapacidadeMaxima());
         this.modelo.setRowCount(0);

         for(Inscricao inscricao : this.inscricaoController.listarInscricoesPorEvento(evento.getCodigo())) {
            this.modelo.addRow(new Object[]{inscricao.getParticipante().getCodigo(), inscricao.getParticipante().getNome(), inscricao.getParticipante().getContato()});
         }

      }
